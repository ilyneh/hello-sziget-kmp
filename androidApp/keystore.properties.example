# Copy this file to keystore.properties (gitignored, sits next to this file) and fill in
# your real values. keystore.properties is required to produce a signed release/beta build —
# see build.gradle.kts, which fails the build with a clear error if it's missing rather than
# silently producing an unsigned artifact.
#
# storeFile is resolved relative to the androidApp/ directory.
storeFile=keystore/release.keystore
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
