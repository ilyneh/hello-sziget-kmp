# https://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
max_line_length = 140

end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{java,kt,kts,scala,rs,xml,kt.spec,kts.spec}]
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
ktlint_ignore_back_ticked_identifier = true

# ktlint owns formatting. Compose files intentionally wildcard-import androidx.compose.*
# packages, so no-wildcard-imports is disabled.
ktlint_standard_no-wildcard-imports = disabled

# Allow capitalized @Composable function names (the standard Compose convention), which
# would otherwise trip the lowercase-camelCase requirement.
ktlint_function_naming_ignore_when_annotated_with = Composable

# We'd like assignments to keep the callee on the same line as `=` (only the argument
# list wraps below), rather than moving the whole value to its own line. Disabling this
# rule here works correctly for the ktlint CLI and IDE plugins that read .editorconfig
# directly, but Spotless's ktlint integration silently ignores this specific property
# regardless of how it's supplied — so `./gradlew spotlessApply` still applies it.
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_string-template-indent = disabled

# LocalAppColors (presentation/theme/AppColors.kt) is an intentional CompositionLocal
# mirroring MaterialTheme.colorScheme's own pattern for our custom AppColorScheme.
compose_allowed_composition_locals = LocalAppColors

[*.md]
trim_trailing_whitespace = false
max_line_length = unset

[gradle/verification-metadata.xml]
indent_size = 3

[*.yml]
ij_yaml_spaces_within_brackets = false